---
import BaseLayout from '../layouts/BaseLayout.astro';
import { brand, notFound } from '../i18n/es.ts';

const title = `${notFound.code} · ${brand.name}`;
---

<BaseLayout title={title} description={notFound.title}>
  <section class="container mx-auto px-4 py-20 max-w-2xl text-center">
    <p class="text-8xl font-bold tabular-nums">{notFound.code}</p>
    <h1 class="mt-4 text-2xl md:text-3xl font-bold">{notFound.title}</h1>
    <p class="mt-3 leading-relaxed opacity-80">{notFound.body}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">{notFound.homeCta}</a>
      <a href="/espana/precio" class="btn btn-outline">{notFound.priceCta}</a>
    </div>
  </section>
</BaseLayout>
