---
import BaseLayout from '../layouts/BaseLayout.astro';
import { brand, notFound, cta } from '../i18n/es.ts';

const title = `${notFound.code} · ${brand.name}`;
---

<BaseLayout title={title} description={notFound.title}>
  <section class="max-w-2xl mx-auto px-4 py-16 text-center">
    <div class="board-plate p-8 md:p-12">
      <p class="font-signage text-8xl md:text-9xl text-primary leading-none tracking-tight">
        {notFound.code}
      </p>
      <h1 class="font-signage uppercase text-3xl md:text-4xl mt-4 leading-tight">
        {notFound.title}
      </h1>
      <p class="mt-4 leading-relaxed opacity-85 text-base md:text-lg max-w-lg mx-auto">
        {notFound.body}
      </p>
      <div class="mt-8 flex flex-wrap justify-center items-center gap-4">
        <a href="/" class="board-cta">
          {notFound.homeCta} →
        </a>
        <a href="/metodo" class="board-navlink">
          {cta.method}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
