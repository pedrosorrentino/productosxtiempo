---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResultView from '../../components/preact/ResultView.tsx';
import { brand } from '../../i18n/es.ts';
import type { Country } from '../../lib/types.ts';
import countriesData from '../../data/countries.json';

export function getStaticPaths() {
  return countriesData.map((country) => ({
    params: { country: country.slug },
    props: { country },
  }));
}

interface Props {
  country: Country;
}

const { country } = Astro.props;
---

<BaseLayout
  title={`${country.name} · ${brand.name}`}
  description={brand.subtitle}
  currentCountrySlug={country.slug}
>
  <section class="max-w-5xl mx-auto px-4 py-8">
    <ResultView
      client:load
      countryCode={country.code}
      countryName={country.name}
      countrySlug={country.slug}
      currencySymbol={country.currencySymbol}
      medianNetMonthly={country.medianNetMonthly}
      legalWeeklyHours={country.legalWeeklyHours}
      realAnnualHours={country.realAnnualHours}
      retirementAge={country.retirementAge}
    />
  </section>
</BaseLayout>
