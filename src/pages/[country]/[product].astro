---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResultView from '../../components/preact/ResultView.tsx';
import { brand, categories } from '../../i18n/es.ts';
import { ogQuote } from '../../lib/ogQuote.ts';
import { getProductPrice, referenceSalary } from '../../lib/selectors.ts';
import { calc } from '../../lib/calc.ts';
import { formatHours, formatHumanDuration, formatIntegerThousands, formatPercent, formatWorkdays } from '../../lib/format.ts';
import type { Country, Product, ProductPrice } from '../../lib/types.ts';
import countriesData from '../../data/countries.json';
import productsData from '../../data/products.json';
import {
  generateHreflangs,
  generateProductSchema,
  generateBreadcrumbSchema,
} from '../../lib/seo.ts';

const allCountries = countriesData as Country[];
const allProducts = productsData as Product[];

interface Props {
  country: Country;
  product: Product;
  price: ProductPrice;
  priceConverted: boolean;
}

export function getStaticPaths() {
  const paths: Array<{ params: { country: string; product: string }; props: Props }> = [];
  for (const country of countriesData as Country[]) {
    for (const product of productsData as Product[]) {
      if (!product.visible) continue;
      const local = product.prices[country.code] as ProductPrice | undefined;
      const price = getProductPrice(product, country.code);
      if (!price) continue; // sin precio base ES → sin página
      paths.push({
        params: { country: country.slug, product: product.id },
        props: {
          country,
          product,
          price,
          priceConverted: local == null || local.origin === 'converted',
        },
      });
    }
  }
  return paths;
}

const { country, product, price, priceConverted } = Astro.props;

const quote = ogQuote(product, country);
const ref = referenceSalary(country);
const hasReference = ref != null;

// Cálculo estático (build time) con el sueldo de referencia declarado:
// mediano neto cuando existe; SMI etiquetado cuando la ficha no lo publica.
let calculatedStats: {
  hours: number;
  workdays8h: number;
  monthsFullPay: number;
  yearsFullPay: number;
  pctRealYear: number;
} | null = null;
if (ref) {
  try {
    const calcRes = calc({
      price: price.value,
      netMonthly: ref.monthly,
      weeklyHours: country.legalWeeklyHours,
      realAnnualHours: country.realAnnualHours,
      monthlySavings: null,
      age: null,
      retirementAge: country.retirementAge,
    });
    calculatedStats = {
      hours: calcRes.hours,
      workdays8h: calcRes.workdays8h,
      monthsFullPay: calcRes.monthsFullPay,
      yearsFullPay: calcRes.yearsFullPay,
      pctRealYear: calcRes.pctRealYear ?? 0,
    };
  } catch (e) {
    calculatedStats = null;
  }
}

// 1. Título y Meta-description SEO optimizados con el patrón de búsqueda
// ("precio / cuánto cuesta [producto] en [país]") y el país obligatorio.
const nfPrice = new Intl.NumberFormat("es-ES", { maximumFractionDigits: 2 });
const priceText = `${nfPrice.format(price.value)} ${country.currencySymbol}`;
const effortText = quote?.effort ?? (calculatedStats
  ? formatHumanDuration(
      calculatedStats.hours,
      calculatedStats.workdays8h,
      calculatedStats.monthsFullPay,
      calculatedStats.yearsFullPay,
    )
  : null);

const pageTitle = ref?.kind === "median" && effortText
  ? `${product.shortName} en ${country.name}: precio ${priceText} y ${effortText} de trabajo · ${brand.name}`
  : `${product.shortName} en ${country.name}: precio ${priceText} · ${brand.name}`;

const pageDescription = ref?.kind === "median" && calculatedStats
  ? `${product.shortName} en ${country.name} cuesta ${priceText}: son ${effortText} con el sueldo mediano neto (${formatIntegerThousands(ref.monthly)} ${country.currencySymbol}/mes). Calcula tu cifra real con tu nómina.`
  : ref?.kind === "min" && calculatedStats
    ? `${product.shortName} en ${country.name} cuesta ${priceText}. Con el SMI de referencia (${formatIntegerThousands(ref.monthly)} ${country.currencySymbol}/mes) son ${effortText} de trabajo. Pon tu nómina y calcula tu cifra real.`
    : `Descubre cuántas horas de trabajo cuesta ${product.name} en ${country.name} (${priceText}). Introduce tu nómina para cotizarlo en tiempo real.`;

// 2. Control de Thin Content / Scaled Content Abuse: noindex solo si el país
// no declara ninguna referencia salarial (hoy ninguno).
const shouldNoIndex = !hasReference;

// 3. Generación de hreflangs
const siteUrl = Astro.site?.href ?? "https://precioentiempo.com";
const hreflangs = generateHreflangs(allCountries, "product", product.id, siteUrl);

// 4. Schema.org JSON-LD
const canonicalUrl = `${siteUrl.replace(/\/$/, "")}/${country.slug}/${product.id}/`;
const imageUrl = `${siteUrl.replace(/\/$/, "")}/og/${country.slug}/${product.id}.png`;

const productSchema = generateProductSchema({
  product,
  country,
  price,
  canonicalUrl,
  imageUrl,
  hours: calculatedStats?.hours,
  workdays8h: calculatedStats?.workdays8h,
  monthsFullPay: calculatedStats?.monthsFullPay,
});

const cleanSite = siteUrl.replace(/\/$/, "");
const categoryName = categories[product.category] ?? product.category;
const categoryUrl = `${cleanSite}/${country.slug}/categoria/${product.category}/`;

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Inicio", url: `${cleanSite}/` },
  { name: country.name, url: `${cleanSite}/${country.slug}/` },
  { name: categoryName, url: categoryUrl },
  { name: product.shortName, url: canonicalUrl },
]);

const combinedJsonLd = [productSchema, breadcrumbSchema];

// 5. Enlazado Interno Automático:
// A) Productos hermanos de la misma categoría en este país
const siblingProducts = allProducts
  .filter((p) => p.visible && p.id !== product.id && p.category === product.category)
  .slice(0, 4)
  .map((sibling) => {
    const sibPrice = getProductPrice(sibling, country.code);
    let sibHours: number | null = null;
    if (sibPrice && ref) {
      try {
        const calcRes = calc({
          price: sibPrice.value,
          netMonthly: ref.monthly,
          weeklyHours: country.legalWeeklyHours,
          realAnnualHours: country.realAnnualHours,
          monthlySavings: null,
          age: null,
          retirementAge: country.retirementAge,
        });
        sibHours = calcRes.hours;
      } catch {
        sibHours = null;
      }
    }
    return {
      ...sibling,
      price: sibPrice,
      hours: sibHours,
    };
  });

const categoryLabel = categories[product.category]?.toLowerCase() ?? product.category;

// B) El mismo producto en otros países clave
const otherCountriesForProduct = allCountries
  .filter((c) => c.code !== country.code && c.medianNetMonthly != null)
  .slice(0, 6);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={`/og/${country.slug}/${product.id}.png`}
  currentCountrySlug={country.slug}
  currentCountryCode={country.code}
  noindex={shouldNoIndex}
  hreflangs={hreflangs}
  jsonLd={combinedJsonLd}
>
  <section class="max-w-5xl mx-auto px-4 py-8">
    <!-- Migas de Pan Semánticas (Breadcrumbs) -->
    <nav class="mb-4 text-xs font-board-mono uppercase tracking-wider opacity-80" aria-label="Migas de pan">
      <ol class="flex items-center gap-2 flex-wrap">
        <li><a href="/" class="hover:text-primary transition-colors">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/${country.slug}/`} class="hover:text-primary transition-colors">{country.name}</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/${country.slug}/categoria/${product.category}/`} class="hover:text-primary transition-colors">{categoryName}</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-primary font-bold" aria-current="page">{product.shortName}</li>
      </ol>
    </nav>

    {/* Vista Interactiva Preact (Con Telemetría Unificada y Bloque Citable) */}
    <ResultView
      client:load
      countryCode={country.code}
      countryName={country.name}
      countrySlug={country.slug}
      currencySymbol={country.currencySymbol}
      medianNetMonthly={country.medianNetMonthly}
      minWageMonthly={country.minWageMonthly}
      legalWeeklyHours={country.legalWeeklyHours}
      realAnnualHours={country.realAnnualHours}
      retirementAge={country.retirementAge}
      productId={product.id}
      productName={product.name}
      productShortName={product.shortName}
      productCategory={product.category}
      catalogPrice={price.value}
      priceConverted={priceConverted}
      catalogPriceDate={price.date}
      catalogPriceSource={price.source}
    />

    {/* BLOQUE CITABLE: precio local + esfuerzo laboral en el HTML servido
        (GEO/SEO). Responde "cuánto cuesta [producto] en [país]" sin depender
        de la isla interactiva. */}
    <section class="mt-8 board-plate p-6 sm:p-8 border border-base-300" aria-label={`Precio y esfuerzo laboral de ${product.shortName} en ${country.name}`}>
      <h2 class="font-signage uppercase text-2xl md:text-3xl">
        {product.shortName} en {country.name}: {priceText}
      </h2>
      {calculatedStats && ref ? (
        <>
          <p class="mt-3 text-sm sm:text-base leading-relaxed opacity-90 font-sans">
            En {country.name}, {product.name} cuesta <strong>{priceText}</strong>. Con el {ref.label} de referencia ({formatIntegerThousands(ref.monthly)} {country.currencySymbol}/mes, {country.legalWeeklyHours} h semanales) equivale a <strong>{formatHours(calculatedStats.hours)} horas de trabajo</strong> ({formatWorkdays(calculatedStats.workdays8h)} jornadas de 8 h), el {formatPercent(calculatedStats.monthsFullPay * 100)}% de una nómina mensual.
            {ref.kind === "min" && " Es una referencia sobre el SMI declarado, no el sueldo mediano neto: con tu neto real el esfuerzo sube."}
          </p>
          <p class="mt-2 text-sm opacity-80 font-sans">
            El sueldo de referencia es orientativo y editable. La cifra que cuenta es la tuya: introduce tu nómina en la calculadora y ajusta el precio si el tuyo es otro.
          </p>
        </>
      ) : (
        <p class="mt-3 text-sm sm:text-base leading-relaxed opacity-90 font-sans">
          {product.name} en {country.name} cuesta {priceText}. Introduce tu nómina en la calculadora para ver cuántas horas y jornadas de trabajo representa.
        </p>
      )}
      <div class="mt-5 pt-3 border-t border-base-300/80 flex flex-wrap gap-x-5 gap-y-2 font-board-mono text-sm">
        <a href={`/${country.slug}/`} class="text-primary hover:underline">Poder adquisitivo en {country.name} &rarr;</a>
        <a href={`/${country.slug}/precio/?precio=${price.value}`} class="text-primary hover:underline">Calcular otro precio &rarr;</a>
        <a href="/metodo/" class="text-primary hover:underline">Método de cálculo &rarr;</a>
      </div>
    </section>

    {/* Enlazado Interno Programático: Categoría en este país */}
    {siblingProducts.length > 0 && (
      <section class="mt-14 board-plate p-6">
        <h2 class="font-signage uppercase text-2xl md:text-3xl">
          Otros productos de {categoryLabel} en {country.name}
        </h2>
        <p class="mt-1 text-sm opacity-80 font-board-mono mb-4">
          Compara las horas de trabajo necesarias para adquirir otros artículos de {categoryLabel}:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {siblingProducts.map((sibling) => {
            const formattedPrice = sibling.price
              ? new Intl.NumberFormat("es-ES", { maximumFractionDigits: 2 }).format(sibling.price.value)
              : null;
            return (
              <a
                href={`/${country.slug}/${sibling.id}/`}
                class="group flex flex-col justify-between p-4 rounded-lg bg-base-200/50 hover:bg-base-200 border border-base-300 hover:border-primary/60 transition-all shadow-xs hover:shadow-md"
              >
                <div>
                  <span class="block font-bold text-base text-base-content group-hover:text-primary transition-colors leading-snug">
                    {sibling.name}
                  </span>
                  <div class="mt-2.5 flex flex-wrap items-baseline gap-2 font-board-mono">
                    {formattedPrice && (
                      <span class="text-sm font-semibold opacity-90">
                        {formattedPrice} {country.currencySymbol}
                      </span>
                    )}
                    {sibling.hours != null && (
                      <span class="text-sm px-2.5 py-0.5 rounded bg-primary/10 text-primary border border-primary/20 font-semibold">
                        ~{formatHours(sibling.hours)} h
                      </span>
                    )}
                  </div>
                </div>

                <div class="mt-4 pt-3 border-t border-base-300/80 flex items-center justify-between">
                  <span class="font-board-mono text-sm font-semibold text-primary flex items-center gap-1.5">
                    Calcular horas
                    <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
                  </span>
                  <span class="font-board-mono text-xs opacity-70 uppercase tracking-wider font-semibold">
                    {country.code}
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {/* Enlazado Interno Programático: Mismo producto en otros países */}
    {otherCountriesForProduct.length > 0 && (
      <section class="mt-8 board-plate p-6">
        <h2 class="font-signage uppercase text-2xl md:text-3xl">
          {product.shortName} en otros países
        </h2>
        <p class="mt-1 text-sm opacity-80 font-board-mono mb-4">
          Compara cuántas horas cuesta este mismo producto según la nómina de cada país:
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
          {otherCountriesForProduct.map((otherC) => (
            <a
              href={`/${otherC.slug}/${product.id}/`}
              class="group flex flex-col justify-between min-h-11 p-3.5 rounded-lg bg-base-200/50 hover:bg-base-200 border border-base-300 hover:border-primary/60 transition-all text-center"
            >
              <span class="block font-bold text-sm truncate text-base-content group-hover:text-primary transition-colors">
                {otherC.name}
              </span>
              <span class="mt-3 font-board-mono text-xs font-semibold text-primary block group-hover:underline">
                Comparar &rarr;
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </section>
</BaseLayout>
