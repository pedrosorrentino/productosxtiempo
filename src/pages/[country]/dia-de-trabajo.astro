---
/**
 * ¿Cuánto vale un día de trabajo en <país>?
 *
 * Responde a la consulta que más impresiones trae ya al sitio sin un solo clic:
 * «cuánto vale un día de trabajo en X» / «cuánto vale una hora de trabajo en X».
 * Quien la escribe quiere un número, así que el número va en el título y en el
 * primer párrafo, con la fórmula y la fuente a la vista.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pickTitle } from '../../lib/titleWidth.ts';
import { WEEKS_PER_MONTH, STANDARD_DAY_HOURS, calcHourlyWage } from '../../lib/calc.ts';
import { formatHourlyWage, formatIntegerThousands, formatHours, formatWorkdays } from '../../lib/format.ts';
import { referenceSalary } from '../../lib/selectors.ts';
import type { Country, Product } from '../../lib/types.ts';
import countriesData from '../../data/countries.json';
import productsData from '../../data/products.json';
import {
  generateHreflangs,
  generateBreadcrumbSchema,
  generateFAQSchema,
} from '../../lib/seo.ts';

export function getStaticPaths() {
  return countriesData.map((country) => ({
    params: { country: country.slug },
    props: { country },
  }));
}

interface Props {
  country: Country;
}

const { country } = Astro.props as Props;
const allCountries = countriesData as Country[];
const products = productsData as Product[];

const siteUrl = Astro.site?.href ?? 'https://precioentiempo.com';
const cleanSite = siteUrl.replace(/\/$/, '');
const canonicalUrl = `${cleanSite}/${country.slug}/dia-de-trabajo/`;
const hreflangs = generateHreflangs(allCountries, 'dia-de-trabajo', undefined, siteUrl);

const ref = referenceSalary(country);

/** Sueldo de referencia (el del país) y sus dos lecturas. */
const mensual = ref?.monthly ?? 0;
const porHora = ref ? calcHourlyWage(ref.monthly, country.legalWeeklyHours) : 0;
const porJornada = porHora * STANDARD_DAY_HOURS;      // 8 h de trabajo
const porDiaNatural = mensual / 30;                    // un día de sueldo, mes ÷ 30
const porSemana = mensual / WEEKS_PER_MONTH;

const simbolo = country.currencySymbol;
const miles = (v: number) => Math.round(v).toLocaleString('es-ES');

function coste(product: Product) {
  const precio = product.prices[country.code];
  if (!precio || precio.origin !== 'local') return null;
  const dias = precio.value / porJornada;
  return { product, precio: precio.value, dias, horas: dias * STANDARD_DAY_HOURS };
}

const conPrecioLocal = products.filter((p) => p.visible).map(coste).filter((x): x is NonNullable<typeof x> => x !== null);
const cabeEnUnDia = conPrecioLocal
  .filter((x) => x.dias >= 0.08 && x.dias <= 1)
  .sort((a, b) => b.dias - a.dias)
  .slice(0, 6);
const cuestaMeses = conPrecioLocal
  .filter((x) => x.dias >= 2)
  .sort((a, b) => a.dias - b.dias)
  .slice(0, 6);

const faqs = [
  {
    question: `¿Cuánto vale un día de trabajo en ${country.name}?`,
    answer: `Con el sueldo de referencia de ${country.name} (${miles(mensual)} ${simbolo}/mes, ${ref?.label ?? 'referencia'}, fuente: ${country.salarySourceLabel}) y una jornada legal de ${country.legalWeeklyHours} horas semanales, una hora de trabajo vale ${formatHourlyWage(porHora, simbolo)} y una jornada completa de 8 horas vale ${miles(porJornada)} ${simbolo}.`,
  },
  {
    question: `¿Cuánto vale una hora de trabajo en ${country.name}?`,
    answer: `${formatHourlyWage(porHora, simbolo)} por hora. Sale de dividir el sueldo mensual de referencia entre las horas que tiene un mes: ${country.legalWeeklyHours} h por semana × 52 semanas ÷ 12 meses = ${Math.round(country.legalWeeklyHours * WEEKS_PER_MONTH)} horas al mes.`,
  },
  {
    question: `¿De dónde sale el sueldo que usáis para ${country.name}?`,
    answer: `${country.salariesSource} Si prefieres usar el tuyo, la calculadora de ${country.name} recalcula todas las cifras con tu nómina, sin que salga de tu dispositivo.`,
  },
  {
    question: `¿Y un día natural de sueldo, sin contar la jornada?`,
    answer: `Un treintavo del sueldo mensual: ${miles(porDiaNatural)} ${simbolo}. Es la cuenta que se usa para descontar un día no trabajado; la de la jornada de 8 h (${miles(porJornada)} ${simbolo}) es la que mide cuánto trabajo cuesta algo.`,
  },
];
const faqSchema = generateFAQSchema(faqs);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Inicio', url: `${cleanSite}/` },
  { name: country.name, url: `${cleanSite}/${country.slug}/` },
  { name: 'Día de trabajo', url: canonicalUrl },
]);

// Sin sufijo de marca a propósito: lo que tiene que caber en el título es el
// número. Es la respuesta a la búsqueda, y el nombre del sitio ya lo añade
// Google por su cuenta.
const pageTitle = pickTitle(
  [
    `¿Cuánto vale un día de trabajo en ${country.name}? ${miles(porJornada)} ${simbolo}`,
    `Día de trabajo en ${country.name}: ${miles(porJornada)} ${simbolo}`,
    `Cuánto vale un día de trabajo en ${country.name}`,
  ],
);
const pageDescription = `En ${country.name}, una hora de trabajo vale ${miles(porHora)} ${simbolo} y una jornada de 8 horas ${miles(porJornada)} ${simbolo}. Cómo se calcula, de dónde sale el sueldo y qué entra en un día de trabajo.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  currentCountrySlug={country.slug}
  currentCountryCode={country.code}
  ogImage={`/og/${country.slug}.png`}
  hreflangs={hreflangs}
  jsonLd={[breadcrumbSchema, faqSchema]}
>
  <div class="max-w-5xl mx-auto px-4 py-8 space-y-8">
    <nav class="text-xs font-board-mono uppercase tracking-wider opacity-80" aria-label="Migas de pan">
      <ol class="flex items-center gap-2 flex-wrap">
        <li><a href="/" class="hover:text-primary transition-colors">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/${country.slug}/`} class="hover:text-primary transition-colors">{country.name}</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-primary font-bold" aria-current="page">Día de trabajo</li>
      </ol>
    </nav>

    <header class="board-plate p-6 sm:p-8 border border-base-300 shadow-md">
      <p class="font-board-mono text-xs uppercase tracking-[0.14em] text-primary font-semibold flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-primary inline-block"></span>
        <span>Respuesta corta · {country.name}</span>
      </p>
      <h1 class="font-signage uppercase text-3xl sm:text-5xl md:text-6xl leading-tight mt-2 tracking-tight">
        ¿Cuánto vale un día de trabajo en {country.name}?
      </h1>
      <p class="mt-4 text-base sm:text-lg font-sans leading-relaxed">
        Una jornada completa de 8 horas vale <strong class="text-primary">{miles(porJornada)} {simbolo}</strong>,
        y una hora de trabajo, <strong class="text-primary">{formatHourlyWage(porHora, simbolo)}</strong>.
        Son cifras calculadas con el sueldo de referencia de {country.name}
        ({miles(mensual)} {simbolo}/mes) y una jornada legal de {country.legalWeeklyHours} horas semanales.
      </p>
    </header>

    <section class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="board-cell p-4">
        <span class="font-board-mono text-[11px] uppercase tracking-wider opacity-70 block">Una hora</span>
        <strong class="font-signage text-2xl sm:text-3xl text-primary block mt-1">{formatHourlyWage(porHora, simbolo)}</strong>
      </div>
      <div class="board-cell p-4">
        <span class="font-board-mono text-[11px] uppercase tracking-wider opacity-70 block">Un día (8 h)</span>
        <strong class="font-signage text-2xl sm:text-3xl text-primary block mt-1">{miles(porJornada)} {simbolo}</strong>
      </div>
      <div class="board-cell p-4">
        <span class="font-board-mono text-[11px] uppercase tracking-wider opacity-70 block">Una semana</span>
        <strong class="font-signage text-2xl sm:text-3xl text-primary block mt-1">{miles(porSemana)} {simbolo}</strong>
      </div>
      <div class="board-cell p-4">
        <span class="font-board-mono text-[11px] uppercase tracking-wider opacity-70 block">Un día de sueldo (mes ÷ 30)</span>
        <strong class="font-signage text-2xl sm:text-3xl text-primary block mt-1">{miles(porDiaNatural)} {simbolo}</strong>
      </div>
    </section>

    <section class="board-plate p-6 sm:p-8 border border-base-300 space-y-4">
      <h2 class="font-signage uppercase text-2xl sm:text-3xl">De dónde sale cada cifra</h2>
      <ul class="space-y-2 font-sans text-sm sm:text-base leading-relaxed">
        <li>
          <strong>Sueldo de referencia:</strong> {miles(mensual)} {simbolo}/mes ({ref?.label ?? 'referencia'}).
          Fuente: <a class="text-primary hover:underline" href={country.salariesSourceUrl} target="_blank" rel="noopener">{country.salarySourceLabel}</a>.
        </li>
        <li>
          <strong>Jornada legal:</strong> {country.legalWeeklyHours} horas por semana.
        </li>
        <li>
          <strong>La hora:</strong> sueldo mensual ÷ ({country.legalWeeklyHours} h × 52 ÷ 12) = {miles(mensual)} ÷ {Math.round(country.legalWeeklyHours * WEEKS_PER_MONTH)} = <strong>{formatHourlyWage(porHora, simbolo)}</strong>.
        </li>
        <li>
          <strong>El día de trabajo:</strong> la hora × 8 = <strong>{miles(porJornada)} {simbolo}</strong>.
        </li>
      </ul>
      <p class="font-sans text-sm opacity-80 leading-relaxed">
        El sueldo de referencia es el <strong>neto mensual</strong>: lo que llega a la cuenta después de
        impuestos y cotizaciones, que es con lo que se compra. El método completo, país por país y con
        sus fuentes, está en <a class="text-primary hover:underline" href="/metodo/">la página de método</a>.
        Si tu sueldo no es el mediano, la
        <a class="text-primary hover:underline" href={`/${country.slug}/precio/`}>calculadora de {country.name}</a>
        recalcula todo con tu nómina sin salir de tu dispositivo.
      </p>
    </section>

    {cabeEnUnDia.length > 0 && (
      <section class="board-plate p-6 sm:p-8 border border-base-300 space-y-4">
        <h2 class="font-signage uppercase text-2xl sm:text-3xl">Qué entra en un día de trabajo en {country.name}</h2>
        <p class="font-sans text-sm opacity-85">
          Precios locales verificados, medidos en jornadas de 8 horas con el sueldo de referencia.
        </p>
        <div class="md:overflow-x-auto md:border md:border-base-300">
          <table class="board-table w-full text-left font-body text-sm">
            <thead>
              <tr class="border-b border-base-300 bg-base-100 font-board-mono text-xs uppercase tracking-[0.1em] text-primary">
                <th class="p-3.5">Producto</th>
                <th class="p-3.5">Precio</th>
                <th class="p-3.5">Días de trabajo</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-base-300">
              {cabeEnUnDia.map(({ product, precio, dias }) => (
                <tr class="bg-base-200/50">
                  <td class="p-3.5 font-semibold text-base-content" data-label="Producto">
                    <a class="hover:text-primary transition-colors" href={`/${country.slug}/${product.id}/`}>{product.shortName}</a>
                  </td>
                  <td class="p-3.5 opacity-90" data-label="Precio">{miles(precio)} {simbolo}</td>
                  <td class="p-3.5 text-primary font-semibold" data-label="Días">{formatWorkdays(dias)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {cuestaMeses.length > 0 && (
      <section class="board-plate p-6 sm:p-8 border border-base-300 space-y-4">
        <h2 class="font-signage uppercase text-2xl sm:text-3xl">Lo que no cabe ni en un mes de trabajo</h2>
        <p class="font-sans text-sm opacity-85">
          Los mismos precios locales, medidos en jornadas completas.
        </p>
        <div class="md:overflow-x-auto md:border md:border-base-300">
          <table class="board-table w-full text-left font-body text-sm">
            <thead>
              <tr class="border-b border-base-300 bg-base-100 font-board-mono text-xs uppercase tracking-[0.1em] text-primary">
                <th class="p-3.5">Producto</th>
                <th class="p-3.5">Precio</th>
                <th class="p-3.5">Días de trabajo</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-base-300">
              {cuestaMeses.map(({ product, precio, dias }) => (
                <tr class="bg-base-200/50">
                  <td class="p-3.5 font-semibold text-base-content" data-label="Producto">
                    <a class="hover:text-primary transition-colors" href={`/${country.slug}/${product.id}/`}>{product.shortName}</a>
                  </td>
                  <td class="p-3.5 opacity-90" data-label="Precio">{miles(precio)} {simbolo}</td>
                  <td class="p-3.5 text-primary font-semibold" data-label="Días">{formatIntegerThousands(Math.round(dias))} jornadas</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="board-plate p-6 sm:p-8 border border-base-300 space-y-4" aria-label="Preguntas Frecuentes">
      <h2 class="font-signage uppercase text-2xl sm:text-3xl">Preguntas frecuentes</h2>
      <div class="space-y-4 pt-2">
        {faqs.map((faq) => (
          <div class="border-b border-base-300 pb-3">
            <h3 class="font-bold text-base text-base-content">{faq.question}</h3>
            <p class="text-sm opacity-80 mt-1 leading-relaxed font-sans">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="board-plate p-6 sm:p-8 border border-base-300 space-y-3">
      <h2 class="font-signage uppercase text-2xl sm:text-3xl">Sigue desde aquí</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 font-sans text-sm">
        <li><a class="text-primary hover:underline" href={`/${country.slug}/`}>Todo lo que cuesta en horas de trabajo en {country.name}</a></li>
        <li><a class="text-primary hover:underline" href={`/${country.slug}/precio/`}>Calculadora: cuántas horas cuesta lo que quieras comprar</a></li>
        <li><a class="text-primary hover:underline" href="/metodo/">Cómo calculamos el sueldo y las horas</a></li>
        <li><a class="text-primary hover:underline" href="/">Precio en Tiempo: todos los países</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>
