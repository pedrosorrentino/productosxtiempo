---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StaleDataBadge from '../../components/astro/StaleDataBadge.astro';
import CountryView from '../../components/preact/CountryView.tsx';
import { calc, calcHourlyWage } from '../../lib/calc.ts';
import { formatHourlyWage, formatHours, formatIntegerThousands, formatMinutes, formatWorkdays } from '../../lib/format.ts';
import { isFreshDate } from '../../lib/freshness.ts';
import { board, brand, categories as categoryLabels, countryPage, noSalary } from '../../i18n/es.ts';
import type { Country, Product } from '../../lib/types.ts';
import countriesData from '../../data/countries.json';
import productsData from '../../data/products.json';
import anchorsData from '../../data/anchors.json';
import macroData from '../../data/macro.json';
import { referenceSalary, hasLocalPrice } from '../../lib/selectors.ts';
import { pickTitle } from '../../lib/titleWidth.ts';
import { generateHreflangs, generateBreadcrumbSchema, generateFAQSchema } from '../../lib/seo.ts';

export function getStaticPaths() {
  return countriesData.map((country) => ({
    params: { country: country.slug },
    props: { country },
  }));
}

const { country } = Astro.props as { country: Country };
const allCountries = countriesData as Country[];

const siteUrl = Astro.site?.href ?? "https://precioentiempo.com";
const cleanSite = siteUrl.replace(/\/$/, "");
const hreflangs = generateHreflangs(allCountries, "country", undefined, siteUrl);
const canonicalUrl = `${cleanSite}/${country.slug}/`;

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Inicio", url: `${cleanSite}/` },
  { name: country.name, url: canonicalUrl },
]);

// Cálculo del salario horario oficial del país
const countryWage =
  country.medianNetMonthly != null
    ? calc({
        price: 1,
        netMonthly: country.medianNetMonthly,
        weeklyHours: country.legalWeeklyHours,
        realAnnualHours: country.realAnnualHours,
        monthlySavings: null,
        age: null,
        retirementAge: country.retirementAge,
      }).hourlyWage
    : null;
const countryWageText =
  countryWage != null ? formatHourlyWage(countryWage, country.currencySymbol) : null;
const hasSalary = countryWageText != null;

// Sueldo de referencia declarado: mediano neto o, si la ficha no lo publica
// (Colombia, Argentina), el SMI etiquetado como referencia. Ataca las
// búsquedas "cuánto vale una hora / un día de trabajo en [país]".
const refSalary = referenceSalary(country);
const refWage = refSalary?.monthly ?? null;
const refWageText = refWage != null ? refWage.toLocaleString("es-ES", { useGrouping: "always" }) : null;
const refIsSmi = refSalary?.kind === "min";
const refHourlyWage = refWage != null ? calcHourlyWage(refWage, country.legalWeeklyHours) : null;

// Índice completo de fichas del país, agrupado por categoría.
//
// La portada de país enlazaba a 33 fichas de 90: las demás solo se alcanzaban por
// la página de categoría o por «productos hermanos». Con un rastreo de ~5 URLs
// por semana, una ficha sin enlace desde una página rastreada no se descubre
// nunca. Este bloque le da a cada ficha con precio local al menos un enlace
// entrante desde la portada del país, que es la que Google visita.
const todasLasFichas = (productsData as Product[])
  .filter((p) => p.visible !== false && hasLocalPrice(p, country.code))
  .map((p) => ({ id: p.id, nombre: p.shortName, categoria: p.category }))
  .sort((a, b) => a.nombre.localeCompare(b.nombre, "es"));

// Tabla de referencia: diez productos que cubren las cinco categorías, con su
// precio en el país y las horas de trabajo que cuestan. Va en el HTML servido
// (no en la isla) para que Google tenga la relación precio-horas como datos, no
// solo como prosa, y para que la página pueda salir como respuesta directa.
const PRODUCTOS_CLAVE = [
  "cesta-semanal",
  "alquiler-piso",
  "habitacion-alquiler",
  "menu-del-dia",
  "cafe",
  "abono-transporte",
  "luz-gas-mes",
  "fibra-mes",
  "iphone",
  "gimnasio-anual",
];

// Cifras pequeñas con decimal: un café de 2,13 € no puede salir como «2 €», y
// 0,25 h no puede salir como «0 h».
const cifraCorta = (n: number) =>
  n < 10
    ? n.toLocaleString("es-ES", { useGrouping: "always", maximumFractionDigits: 2 })
    : formatIntegerThousands(n);
const horasCortas = (h: number) =>
  h < 10 ? (Math.round(h * 10) / 10).toLocaleString("es-ES") : formatHours(h);

const tablaClave = PRODUCTOS_CLAVE.map((id) => {
  const producto = (productsData as Product[]).find((p) => p.id === id);
  if (!producto || !refSalary) return null;
  const precio = producto.prices[country.code];
  if (!precio || precio.origin !== "local" || !precio.value) return null;
  try {
    const r = calc({
      price: precio.value,
      netMonthly: refSalary.monthly,
      weeklyHours: country.legalWeeklyHours,
      realAnnualHours: country.realAnnualHours,
      monthlySavings: null,
      age: null,
      retirementAge: country.retirementAge,
    });
    return {
      id,
      nombre: producto.shortName,
      precio: precio.value,
      horas: r.hours,
      porcentaje: Math.round((r.hours / ((country.legalWeeklyHours * 52) / 12)) * 100),
    };
  } catch {
    return null;
  }
}).filter((x): x is { id: string; nombre: string; precio: number; horas: number; porcentaje: number } => x !== null);

const fichasPorCategoria = Object.entries(
  todasLasFichas.reduce<Record<string, typeof todasLasFichas>>((acc, ficha) => {
    (acc[ficha.categoria] ??= []).push(ficha);
    return acc;
  }, {}),
).sort((a, b) => b[1].length - a[1].length);
const nfGroup1 = new Intl.NumberFormat("es-ES", { minimumFractionDigits: 1, maximumFractionDigits: 1, useGrouping: "always" });
const nfGroup2 = new Intl.NumberFormat("es-ES", { minimumFractionDigits: 2, maximumFractionDigits: 2, useGrouping: "always" });
const refHourlyText = refHourlyWage != null
  ? `${(refHourlyWage < 20 ? nfGroup2 : nfGroup1).format(refHourlyWage)} ${country.currencySymbol}`
  : null;
const refDailyWage = refHourlyWage != null ? refHourlyWage * 8 : null;
const nfMoney0 = new Intl.NumberFormat("es-ES", { useGrouping: "always", maximumFractionDigits: 0 });
const refDailyText = refDailyWage != null ? `${nfMoney0.format(refDailyWage)} ${country.currencySymbol}` : null;

const countryMacro = (macroData as Record<string, any>)[country.code] || {};
const pppFactor = country.pppFactor ?? countryMacro.pppFactor ?? null;
const inflationRate = country.inflationRate ?? countryMacro.inflationRate ?? null;
const minWageMonthly = country.minWageMonthly ?? countryMacro.minWageMonthly ?? null;

const products: Product[] = productsData as Product[];
// hasLocalPrice viene de lib/selectors.ts (precio con origen «local»). Antes
// había aquí una copia local que solo miraba si existía precio, así que los
// hubs listaban también los convertidos.
const priceOf = (product: Product, code: string) => product.prices[code];

/** Cotizaciones precalculadas en build time para SSR/SEO */
type QuotedRow = {
  product: Product;
  local: boolean;
  price: number | null;
  workdays: string | null;
  unit: string | null;
  hours: number | null;
  years: number | null;
  isFresh?: boolean;
};
const quoteRows = (group: { products: Product[] }): QuotedRow[] =>
  group.products.map((product) => {
    const local = hasLocalPrice(product, country.code);
    const price = priceOf(product, country.code) ?? null;
    if (!price || country.medianNetMonthly == null) {
      return { product, local, price: price?.value ?? null, workdays: null, unit: null, hours: null, years: null, isFresh: false };
    }
    try {
      const r = calc({
        price: price.value,
        netMonthly: country.medianNetMonthly,
        weeklyHours: country.legalWeeklyHours,
        realAnnualHours: null,
        monthlySavings: null,
        age: null,
        retirementAge: country.retirementAge,
      });
      const hours = r.hours;
      const workdays8h = r.workdays8h;
      let text: string;
      let unit: string;
      if (hours < 1) {
        text = formatMinutes(hours * 60);
        unit = text === "1" ? "minuto" : "minutos";
      } else if (workdays8h < 1) {
        text = formatHours(hours);
        unit = text === "1" ? "hora" : "horas";
      } else {
        text = formatWorkdays(workdays8h);
        unit = "jornadas";
      }
      return {
        product,
        local,
        price: price.value,
        workdays: text,
        unit,
        hours,
        years: r.yearsFullPay,
        isFresh: isFreshDate(price.date),
      };
    } catch {
      return { product, local, price: price?.value ?? null, workdays: null, unit: null, hours: null, years: null, isFresh: false };
    }
  });

const categoryOrder: Product['category'][] = ['transporte', 'tecnologia', 'vivienda', 'vida', 'dia-a-dia'];
const catalog = categoryOrder
  .map((category) => ({
    category,
    // Solo lo que tiene precio TOMADO EN EL PAÍS: el hub no enseña conversiones.
    products: products.filter(
      (p) => p.visible && p.category === category && hasLocalPrice(p, country.code),
    ),
  }))
  .filter((group) => group.products.length > 0);

/** Filas serializables para la isla interactiva CountryView */
const boardGroups = catalog.map((group) => ({
  category: group.category,
  rows: quoteRows(group).map((row) => ({
    id: row.product.id,
    name: row.product.name,
    price: row.price,
    local: row.local,
    category: group.category,
    hours: row.hours,
    years: row.years,
    defaultHours: row.hours,
    defaultYears: row.years,
    defaultRateText: row.workdays,
    defaultRateUnit: row.unit,
    rateText: row.workdays,
    rateUnit: row.unit,
    isFresh: row.isFresh && row.local,
  })),
}));

// Anclas de referencia local (café, iphone, alquiler, etc.)
const countryAnchors = (anchorsData as Record<string, Record<string, number | null>>)[country.code] ?? {};

// Otros países para el interlinking transfronterizo
const otherCountries = allCountries.filter((c) => c.code !== country.code && c.medianNetMonthly != null);

// Cálculo del alquiler en horas para el bloque citable
const rentPrice = countryAnchors.alquiler ?? (country.currency === "EUR" ? 900 : 12000);
const rentHours = countryWage && countryWage > 0 ? Math.round(rentPrice / countryWage) : 86;
const rentPctSalary = country.medianNetMonthly ? Math.round((rentPrice / country.medianNetMonthly) * 100) : 50;

// Preguntas Frecuentes estructuradas para SEO & GEO
// Dos preguntas que se escriben mucho en el autocompletado («cuántas horas se
// trabaja al mes en X», «cuál es el salario mínimo en X») y que la portada no
// respondía con esas palabras, aunque el dato ya estuviera dentro.
const horasAlMes = Math.round((country.legalWeeklyHours * 52) / 12);
const minMensual = country.minWageMonthly ?? null;
const minHora = minMensual ? calcHourlyWage(minMensual, country.legalWeeklyHours) : null;

const faqs = [
  {
    question: `¿Cuántas horas se trabaja al mes en ${country.name}?`,
    answer: `Con la jornada legal de ${country.legalWeeklyHours} horas semanales, un mes tiene ${horasAlMes} horas de trabajo (${country.legalWeeklyHours} × 52 semanas ÷ 12 meses). Si se descuentan vacaciones y festivos, el año trabajado baja a ${country.realAnnualHours ? formatIntegerThousands(country.realAnnualHours) + ' horas' : 'unas 1.650 horas'}, es decir, unas ${country.realAnnualHours ? Math.round(country.realAnnualHours / 12) : 138} al mes. Las horas «de reloj» son más que las efectivas.`,
  },
  ...(minMensual && minHora
    ? [
        {
          question: `¿Cuál es el salario mínimo en ${country.name}?`,
          answer: `${formatIntegerThousands(minMensual)} ${country.currencySymbol}/mes${country.minWageSourceLabel ? `, según ${country.minWageSourceLabel}` : ''}. Con la jornada legal de ${country.legalWeeklyHours} h, el mínimo sale a ${formatHourlyWage(minHora, country.currencySymbol)} por hora${countryWageText ? `, frente a los ${countryWageText} de la hora mediana` : ''}. Es un suelo legal, no lo que gana la mayoría.`,
        },
      ]
    : []),
  {
    question: `¿Cuál es el salario mediano neto por hora en ${country.name}?`,
    answer: `En ${country.name}, el sueldo mediano neto de referencia es de ${formatIntegerThousands(country.medianNetMonthly ?? 0)} ${country.currencySymbol}/mes. Considerando una jornada laboral legal de ${country.legalWeeklyHours} horas semanales (fórmula de 52 semanas repartidas en 12 meses), una hora de trabajo neto equivale aproximadamente a ${countryWageText ?? "10 " + country.currencySymbol + "/hora"}, según ${country.salarySourceLabel} (${country.salariesSource}).`,
  },
  {
    question: `¿Cuántas horas de trabajo cuesta el alquiler mensual en ${country.name}?`,
    answer: `Un alquiler medio de referencia en ${country.name} (${rentPrice.toLocaleString("es-ES", { useGrouping: "always" })} ${country.currencySymbol}) exige aproximadamente ${rentHours} horas de trabajo real (${Math.round(rentHours / 8)} jornadas laborales completas de 8 horas), absorbiendo en torno al ${rentPctSalary}% del sueldo neto mensual mediano.`,
  },
  {
    question: `¿Cuántas horas anuales se trabajan realmente en ${country.name} según la OCDE?`,
    answer: `Según los registros estadísticos de la OCDE, en ${country.name} se trabajan de media efectiva ${country.realAnnualHours ? formatIntegerThousands(country.realAnnualHours) : "1.650"} horas reales al año por trabajador, tras descontar vacaciones reglamentarias, festivos nacionales y permisos laborales.`,
  },
  {
    question: `¿Por qué medir los precios de ${country.name} en horas de trabajo y no en dinero?`,
    answer: `El dinero en divisas fluctúa con la inflación y la percepción subjetiva. Convertir el precio de un bien o servicio en horas de trabajo real permite evaluar el coste de oportunidad vital: qué fracción exacta de tu tiempo finito de vida entregas al mercado laboral a cambio de esa adquisición.`,
  },
  {
    question: `¿Cuánto vale una hora de trabajo en ${country.name}?`,
    answer: refIsSmi
      ? `La ficha de ${country.name} no publica un sueldo mediano neto. Como referencia, el SMI declarado (${refWage?.toLocaleString("es-ES", { useGrouping: "always" })} ${country.currencySymbol}/mes) equivale a ${refHourlyText} por hora con una jornada de ${country.legalWeeklyHours} h semanales. Es una referencia sobre el SMI, no el sueldo mediano: con tu neto real la hora baja.`
      : `Con el sueldo mediano neto de referencia (${refWage?.toLocaleString("es-ES", { useGrouping: "always" })} ${country.currencySymbol}/mes) y una jornada de ${country.legalWeeklyHours} h semanales, una hora de trabajo vale aproximadamente ${refHourlyText}. Es orientativo: tu hora real sale de tu propia nómina.`,
  },
  {
    question: `¿Cuánto vale un día de trabajo en ${country.name}?`,
    answer: refIsSmi
      ? `Un día de trabajo (jornada de 8 horas) equivale a unos ${refDailyText} en ${country.name}, según el SMI declarado. Es una referencia bruta, no el sueldo mediano neto.`
      : `Un día de trabajo de 8 horas vale aproximadamente ${refDailyText} en ${country.name}, calculado con el sueldo mediano neto de referencia (${refWage?.toLocaleString("es-ES", { useGrouping: "always" })} ${country.currencySymbol}/mes).`,
  },
];

const faqSchema = generateFAQSchema(faqs);
const combinedJsonLd = [breadcrumbSchema, faqSchema];

// Meta SEO — título ajustado al ancho que Google muestra (~600 px)
const pageTitle = pickTitle(
  [
    hasSalary
      ? `${country.name}: sueldo por hora ${countryWageText} y cuánto vale un día de trabajo`
      : `${country.name}: cuánto vale una hora y un día de trabajo`,
    hasSalary
      ? `${country.name}: sueldo por hora y día de trabajo`
      : `${country.name}: cuánto vale un día de trabajo`,
    `${country.name}: cuánto vale un día de trabajo`,
  ],
  ` · ${brand.name}`,
);

const pageDescription = hasSalary
  ? `En ${country.name}, una hora de trabajo vale ${countryWageText} y un día de 8 h ${refDailyText}. Sale del sueldo mediano neto (${formatIntegerThousands(country.medianNetMonthly ?? 0)} ${country.currencySymbol}/mes). Mira cuántas horas cuestan tu alquiler, la tecnología y el día a día.`
  : `En ${country.name} no hay mediano neto publicado: con el SMI de referencia (${refWageText} ${country.currencySymbol}/mes) la hora sale a ${refHourlyText} y el día de 8 h a ${refDailyText}. Calcula cuánto de tu tiempo cuesta cualquier compra.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={`/og/${country.slug}.png`}
  currentCountrySlug={country.slug}
  currentCountryCode={country.code}
  hreflangs={hreflangs}
  jsonLd={combinedJsonLd}
>
  <div class="max-w-5xl mx-auto px-4 pt-6 pb-20 space-y-8">
    <!-- Migas de pan semánticas -->
    <nav class="text-xs font-board-mono uppercase tracking-wider opacity-80" aria-label="Migas de pan">
      <ol class="flex items-center gap-2 flex-wrap">
        <li><a href="/" class="hover:text-primary transition-colors">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-primary font-bold" aria-current="page">{country.name}</li>
      </ol>
    </nav>

    <!-- Placa de Identidad del País -->
    <header class="board-plate p-5 sm:p-6 border border-base-300 shadow-md">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="font-board-mono text-xs uppercase tracking-[0.14em] opacity-75 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-primary inline-block"></span>
            <span>{board.operatingLabel} · Ficha Nacional de Esfuerzo</span>
          </p>
          <h1 class="font-signage uppercase text-4xl sm:text-5xl md:text-6xl leading-none mt-1.5 tracking-tight">
            {country.name}: cuánto vale una hora y un día de trabajo
          </h1>
        </div>

        <div class="flex items-center gap-2">
          <span class="px-3 py-1 rounded-md font-board-mono text-xs font-bold bg-base-200 border border-base-content/10 uppercase tracking-wider">
            {country.currency} ({country.currencySymbol})
          </span>
          <span class="px-3 py-1 rounded-md font-board-mono text-xs font-bold bg-primary/10 text-primary border border-primary/20 uppercase tracking-wider">
            Jornada {country.legalWeeklyHours} h
          </span>
        </div>
      </div>

      {hasSalary && (
        <div class="mt-4 pt-3 border-t border-base-content/10 flex flex-wrap items-center gap-x-4 gap-y-1 font-board-mono text-xs opacity-75">
          <span>{countryPage.dataFrom(country.salariesUpdatedAt)}</span>
          <span aria-hidden="true" class="text-primary font-bold">·</span>
          <span>{countryPage.sourceLabel}: {country.salariesSource}</span>
          <StaleDataBadge date={country.salariesUpdatedAt} />
        </div>
      )}
    </header>

    <!-- Navegación a Hubs de Categoría -->
    <section class="board-plate p-4 sm:p-5 border border-base-300" aria-label="Categorías temáticas">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <span class="font-board-mono text-xs uppercase tracking-wider opacity-75 font-semibold">
          Explorar por categorías en {country.name}:
        </span>
        <div class="flex flex-wrap items-center gap-2">
          {categoryOrder.map((cat) => (
            <a
              href={`/${country.slug}/categoria/${cat}/`}
              class="min-h-11 inline-flex items-center px-3 py-1.5 rounded-md font-board-mono text-xs uppercase font-medium bg-base-200 hover:bg-base-300 border border-base-content/10 hover:border-primary/50 text-base-content hover:text-primary transition-all"
            >
              {cat === 'transporte' ? 'Transporte' : cat === 'tecnologia' ? 'Tecnología' : cat === 'vivienda' ? 'Vivienda' : cat === 'dia-a-dia' ? 'Día a día' : 'Vida'} →
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Radiografía Socioeconómica y Esfuerzo Laboral Oficial (Banco Mundial, OCDE, Eurostat) -->
    <section class="board-plate p-5 sm:p-6 border border-base-300 space-y-4" aria-label="Radiografía socioeconómica oficial">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-base-300/80 pb-3">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-primary inline-block"></span>
          <h2 class="font-signage uppercase text-xl sm:text-2xl tracking-wide">
            Radiografía Económica Oficial de {country.name}
          </h2>
        </div>
        <span class="font-board-mono text-xs opacity-75">
          Fuentes: Banco Mundial · OCDE · Eurostat / INE
        </span>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 font-board-mono text-xs sm:text-sm">
        <div class="board-cell p-3.5 space-y-1">
          <span class="opacity-70 text-xs block uppercase">Sueldo Mediano Neto</span>
          <strong class="text-base sm:text-xl font-bold text-primary block">
            {country.medianNetMonthly ? `${formatIntegerThousands(country.medianNetMonthly)} ${country.currencySymbol}/mes` : 'No disponible'}
          </strong>
          <span class="text-[11px] opacity-60 block">Percentil 50 representativo</span>
        </div>

        <div class="board-cell p-3.5 space-y-1">
          <span class="opacity-70 text-xs block uppercase">Salario Mínimo Legal (SMI)</span>
          <strong class="text-base sm:text-xl font-bold block">
            {minWageMonthly ? `${formatIntegerThousands(minWageMonthly)} ${country.currencySymbol}/mes` : 'Convenio sectorial'}
          </strong>
          <span class="text-[11px] opacity-60 block">
            {minWageMonthly && country.medianNetMonthly
              ? `${Math.round((minWageMonthly / country.medianNetMonthly) * 100)}% del sueldo mediano`
              : 'Regulado sectorialmente'}
          </span>
        </div>

        <div class="board-cell p-3.5 space-y-1">
          <span class="opacity-70 text-xs block uppercase">Jornada Anual Efectiva</span>
          <strong class="text-base sm:text-xl font-bold block">
            {country.realAnnualHours ? `${country.realAnnualHours} h/año` : `${country.legalWeeklyHours} h/sem`}
          </strong>
          <span class="text-[11px] opacity-60 block">OCDE (descontando festivos)</span>
        </div>

        <div class="board-cell p-3.5 space-y-1">
          <span class="opacity-70 text-xs block uppercase">Paridad Poder Compra (PPA)</span>
          <strong class="text-base sm:text-xl font-bold text-accent block">
            {pppFactor ? `${pppFactor} ${country.currency}/$ int.` : 'N/D'}
          </strong>
          <span class="text-[11px] opacity-60 block">
            {inflationRate ? `PPA · Inflación oficial: ${inflationRate}%` : 'Factor PPA Banco Mundial'}
          </span>
        </div>
      </div>
    </section>

    <!-- VALOR DE LA HORA Y EL DÍA DE TRABAJO (long tail "cuánto vale un día/hora de trabajo en [país]") -->
    {refWage != null && (
      <section class="board-plate p-5 sm:p-6 border border-base-300 space-y-3" aria-label={`Valor de la hora y el día de trabajo en ${country.name}`}>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-primary inline-block"></span>
          <h2 class="font-signage uppercase text-xl sm:text-2xl tracking-wide">
            ¿Cuánto vale una hora y un día de trabajo en {country.name}?
          </h2>
        </div>
        <p class="text-sm sm:text-base leading-relaxed opacity-90 font-sans">
          {hasSalary ? (
            <>
              Con el sueldo mediano neto de referencia de {country.name} (<strong>{refWageText} {country.currencySymbol}/mes</strong>) y la jornada legal de {country.legalWeeklyHours} h semanales, una hora de trabajo vale <strong>{refHourlyText}</strong> y un día de 8 horas, <strong>{refDailyText}</strong>.
            </>
          ) : (
            <>
              Esta ficha no publica un sueldo mediano neto. Como referencia, el SMI declarado (<strong>{refWageText} {country.currencySymbol}/mes</strong>) sale a <strong>{refHourlyText}</strong> por hora y <strong>{refDailyText}</strong> por jornada de 8 horas. Es una referencia sobre el SMI, no el mediano.
            </>
          )}
        </p>
        <p class="text-xs font-board-mono opacity-75">
          Fórmula: sueldo de referencia ÷ ({country.legalWeeklyHours} h × 52 ÷ 12). Fuente: {country.salariesSource}. Dato de {country.salariesUpdatedAt}.
        </p>
        <p class="text-sm font-sans pt-1 space-y-1">
          <a class="text-primary hover:underline font-semibold" href={`/${country.slug}/dia-de-trabajo/`}>
            Ver el desglose: cuánto vale una hora, un día y una semana de trabajo en {country.name} →
          </a>
          <a class="block text-primary hover:underline font-semibold" href={`/${country.slug}/sueldo-por-hora/`}>
            Sueldo por hora en {country.name}, país por sector y mínimo legal →
          </a>
        </p>
      </section>
    )}

    {!hasSalary && (
      <div role="alert" class="board-plate p-5 border-l-4 border-l-warning">
        <h2 class="font-signage uppercase text-2xl">{noSalary.title}</h2>
        <p class="text-sm opacity-80 mt-1">{noSalary.body}</p>
      </div>
    )}

    <!-- Centro de Mando Interactivo Reactivo (Tacómetro Bestia + Modo Vida + Catálogo en Vivo) -->
    <main>
      <CountryView
        client:load
        country={country}
        groups={boardGroups}
        anchors={countryAnchors}
      />
    </main>

    <!-- BLOQUE CITABLE DIRECTO: AI Overviews / Google Snippets / Perplexity (GEO & SEO).
         Plegado por defecto: repite cifras ya mostradas arriba, así que no ocupa
         scroll, pero sigue en el HTML para los rastreadores. -->
    <details class="board-details board-plate p-6 sm:p-8 bg-base-200/50 border border-base-300">
      <summary>
        <span class="px-2.5 py-0.5 rounded text-xs font-board-mono uppercase font-bold tracking-wider bg-primary/15 text-primary border border-primary/30">
          Informe Económico Citable
        </span>
        <span class="font-board-mono text-sm opacity-75">Datos verificados {country.salariesUpdatedAt}</span>
        <span class="board-caret ml-auto" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width={2} stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
        </span>
      </summary>

      <div class="mt-4 space-y-4">
      <h2 class="font-signage uppercase text-2xl sm:text-3xl text-base-content">
        Poder adquisitivo y coste de la vida en {country.name} en horas de trabajo
      </h2>
      <p class="font-sans text-sm">
        <a class="text-primary hover:underline" href={`/vivir-en/${country.slug}/`}>Cuánto se necesita para vivir en {country.name} →</a>
      </p>

      <p class="text-sm sm:text-base leading-relaxed opacity-90 font-sans">
        En <strong>{country.name}</strong>, el sueldo mediano neto de referencia se sitúa en <strong>{formatIntegerThousands(country.medianNetMonthly ?? 0)} {country.currencySymbol} al mes</strong>. Bajo una semana laboral estándar de <strong>{country.legalWeeklyHours} horas</strong>, una hora de trabajo real se retribuye a una tasa de <strong>{countryWageText ?? "10 " + country.currencySymbol + "/hora"}</strong>, a partir de {country.salarySourceLabel} ({country.salariesSource}).
      </p>

      <p class="text-sm sm:text-base leading-relaxed opacity-90 font-sans">
        Esta métrica temporal revela que pagar un mes de alquiler medio ({rentPrice.toLocaleString("es-ES", { useGrouping: "always" })} {country.currencySymbol}) absorbe aproximadamente <strong>{rentHours} horas de trabajo íntegro</strong> ({Math.round(rentHours / 8)} jornadas completas), mientras que bienes de consumo diario como un menú del día ({formatIntegerThousands(countryAnchors.menu ?? 14)} {country.currencySymbol}) demandan en torno a <strong>{countryWage ? formatHours((countryAnchors.menu ?? 14) / countryWage) : "1,2"} horas</strong> de esfuerzo laboral neto.
      </p>

      {tablaClave.length >= 5 && (
        <div class="mt-6 overflow-x-auto">
          <table class="board-table w-full text-left font-body text-sm">
            <caption class="sr-only">
              Precio en {country.name} y horas de trabajo que cuesta cada producto, con el sueldo mediano del país
            </caption>
            <thead>
              <tr class="border-b border-base-300 bg-base-100 font-board-mono text-xs uppercase tracking-[0.1em] text-primary">
                <th class="p-3">Producto</th>
                <th class="p-3 text-right">Precio</th>
                <th class="p-3 text-right">Horas de trabajo</th>
                <th class="p-3 text-right">Del mes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-base-300">
              {tablaClave.map((f) => (
                <tr>
                  <td class="p-3">
                    <a class="text-primary hover:underline" href={`/${country.slug}/${f.id}/`}>{f.nombre}</a>
                  </td>
                  <td class="p-3 text-right font-board-mono">{cifraCorta(f.precio)} {country.currencySymbol}</td>
                  <td class="p-3 text-right font-board-mono font-bold">{horasCortas(f.horas)} h</td>
                  <td class="p-3 text-right font-board-mono opacity-80">{f.porcentaje === 0 ? "<1" : f.porcentaje}%</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-2 font-sans text-xs opacity-70">
            Precios tomados en {country.name}, no conversiones. Las horas se calculan con el sueldo mediano neto
            ({formatIntegerThousands(refSalary?.monthly ?? 0)} {country.currencySymbol}/mes) y la jornada legal de {country.legalWeeklyHours} h.
          </p>
        </div>
      )}

      <!-- Retícula resumen de magnitud -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-2">
        <div class="board-cell p-3">
          <span class="font-board-mono text-xs uppercase opacity-80 block font-semibold">Hora Neta Mediana</span>
          <span class="font-board-mono text-lg font-bold text-primary block mt-0.5">{countryWageText ?? "N/D"}</span>
        </div>
        <div class="board-cell p-3">
          <span class="font-board-mono text-xs uppercase opacity-80 block font-semibold">Jornada Semanal</span>
          <span class="font-board-mono text-lg font-bold block mt-0.5">{country.legalWeeklyHours} h / sem</span>
        </div>
        <div class="board-cell p-3">
          <span class="font-board-mono text-xs uppercase opacity-80 block font-semibold">Horas Reales / Año</span>
          <span class="font-board-mono text-lg font-bold block mt-0.5">{country.realAnnualHours ? `${formatIntegerThousands(country.realAnnualHours)} h` : "1.650 h"}</span>
        </div>
        <div class="board-cell p-3">
          <span class="font-board-mono text-xs uppercase opacity-80 block font-semibold">Jubilación Legal</span>
          <span class="font-board-mono text-lg font-bold block mt-0.5">{country.retirementAge} años</span>
        </div>
      </div>
      </div>
    </details>

    <!-- PREGUNTAS FRECUENTES (FAQ ACORDEÓN CON SCHEMA JSON-LD) -->
    <section class="board-plate p-6 sm:p-8 border border-base-300 space-y-6" aria-label="Preguntas Frecuentes">
      <div>
        <h2 class="font-signage uppercase text-2xl sm:text-3xl">
          Preguntas frecuentes sobre el coste de la vida en {country.name}
        </h2>
        <p class="font-board-mono text-sm opacity-80 mt-1">
          Respuestas matemáticas y oficiales sobre el valor del tiempo de trabajo y poder adquisitivo:
        </p>
      </div>

      <div class="space-y-3">
        {faqs.map((faq) => (
          <details
            class="group bg-base-200/60 open:bg-base-200 rounded-lg border border-base-300 transition-all p-4"
          >
            <summary class="min-h-11 font-signage uppercase text-lg cursor-pointer select-none flex items-center justify-between gap-4 text-base-content group-open:text-primary">
              <span>{faq.question}</span>
              <span class="text-xs font-board-mono opacity-60 group-open:rotate-180 transition-transform">
                ▼
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed opacity-85 font-sans pt-2 border-t border-base-content/10">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- ENLAZADO TRANSFRONTERIZO: COMPARAR CON OTROS PAÍSES -->
    {otherCountries.length > 0 && (
      <section class="board-plate p-6 sm:p-8 border border-base-300 space-y-4" aria-label="Comparativa internacional">
        <div>
          <h2 class="font-signage uppercase text-2xl sm:text-3xl">
            Comparar el poder adquisitivo de {country.name} con otros países
          </h2>
          <p class="font-board-mono text-xs opacity-75 mt-1">
            Descubre cuántas horas cuesta la vida en otras economías con su respectivo salario mediano:
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 pt-2">
          {otherCountries.map((otherC) => {
            const otherWage = otherC.medianNetMonthly != null
              ? calc({
                  price: 1,
                  netMonthly: otherC.medianNetMonthly,
                  weeklyHours: otherC.legalWeeklyHours,
                  realAnnualHours: otherC.realAnnualHours,
                  monthlySavings: null,
                  age: null,
                  retirementAge: otherC.retirementAge,
                }).hourlyWage
              : null;
            const otherWageFormatted = otherWage ? formatHourlyWage(otherWage, otherC.currencySymbol) : null;

            return (
              <a
                href={`/${otherC.slug}/`}
                class="group flex flex-col justify-between p-3.5 rounded-lg bg-base-200/50 hover:bg-base-200 border border-base-300 hover:border-primary/60 transition-all shadow-xs"
              >
                <div>
                  <span class="block font-bold text-sm truncate text-base-content group-hover:text-primary transition-colors">
                    {otherC.name}
                  </span>
                  <span class="block font-board-mono text-xs text-primary font-semibold mt-1">
                    {otherWageFormatted ?? `${formatIntegerThousands(otherC.medianNetMonthly ?? 0)} ${otherC.currencySymbol}`}
                  </span>
                </div>
                <div class="mt-3 pt-2 border-t border-base-content/10 flex items-center justify-between text-xs font-board-mono opacity-80 font-semibold">
                  <span>{otherC.code}</span>
                  <span class="group-hover:translate-x-0.5 transition-transform text-primary font-bold">&rarr;</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </div>

    {/* Índice completo de fichas: enlazado interno para que ninguna quede a dos
        clics de una página que Google no visita. */}
    {fichasPorCategoria.length > 0 && (
      <section class="mt-14 border-t border-base-300 pt-8" aria-label={`Todas las fichas de ${country.name}`}>
        <h2 class="font-signage uppercase text-xl md:text-2xl">
          Todos los precios de {country.name}, en horas
        </h2>
        <p class="mt-2 font-sans text-sm opacity-80">
          {todasLasFichas.length} fichas con precio tomado en {country.name}, ordenadas por categoría.
        </p>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {fichasPorCategoria.map(([categoria, fichas]) => (
            <div>
              <h3 class="font-board-mono text-xs uppercase tracking-wider opacity-70">
                {categoryLabels[categoria as Product['category']] ?? categoria} ({fichas.length})
              </h3>
              <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 font-sans text-sm">
                {fichas.map((f) => (
                  <li>
                    <a class="text-primary hover:underline inline-flex items-center min-h-6" href={`/${country.slug}/${f.id}/`}>
                      {f.nombre}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}
</BaseLayout>
