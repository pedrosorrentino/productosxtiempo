---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StaleDataBadge from '../../components/astro/StaleDataBadge.astro';
import UserForm from '../../components/preact/UserForm.tsx';
import PriceInput from '../../components/preact/PriceInput.tsx';
import Odometer from '../../components/preact/Odometer.tsx';
import CountryBoard from '../../components/preact/CountryBoard.tsx';
import { calc } from '../../lib/calc.ts';
import { formatHourlyWage, formatHours, formatIntegerThousands, formatMinutes, formatWorkdays } from '../../lib/format.ts';
import { board, brand, countryPage, noSalary, og, priceForm, userForm } from '../../i18n/es.ts';
import type { Country, Product } from '../../lib/types.ts';
import countriesData from '../../data/countries.json';
import productsData from '../../data/products.json';

export function getStaticPaths() {
  return countriesData.map((country) => ({
    params: { country: country.slug },
    props: { country },
  }));
}

interface Props {
  country: Country;
}

const { country } = Astro.props;

// price = 1: hourlyWage de calc no depende del precio, así obtenemos la hora del país.
const countryWage =
  country.medianNetMonthly != null
    ? calc({
        price: 1,
        netMonthly: country.medianNetMonthly,
        weeklyHours: country.legalWeeklyHours,
        realAnnualHours: country.realAnnualHours,
        monthlySavings: null,
        age: null,
        retirementAge: country.retirementAge,
      }).hourlyWage
    : null;
const countryWageText =
  countryWage != null ? formatHourlyWage(countryWage, country.currencySymbol) : null;
const hasSalary = countryWageText != null;
// La cifra rodable es el número sin el símbolo: "10,38" (el €/hora va como unidad ámbar).
const wageDigits = countryWage != null ? countryWageText!.replace(` ${country.currencySymbol}`, "") : "";

const products: Product[] = productsData as Product[];
const hasLocalPrice = (product: Product, code: string): boolean =>
  product.prices[code] !== undefined;
const priceOf = (product: Product, code: string) => product.prices[code];

/** Cotización de cada producto con la mediana del país, calculada en build
 * time (mismas cards que la pizarra de la portada). */
type QuotedRow = {
  product: Product;
  local: boolean;
  price: number | null;
  workdays: string | null;
  unit: string | null;
  years: number | null;
};
const quoteRows = (group: { products: Product[] }): QuotedRow[] =>
  group.products.map((product) => {
    const local = hasLocalPrice(product, country.code);
    const price = priceOf(product, country.code) ?? null;
    if (!price || country.medianNetMonthly == null) {
      return { product, local, price: price?.value ?? null, workdays: null, unit: null, years: null };
    }
    try {
      const r = calc({
        price: price.value,
        netMonthly: country.medianNetMonthly,
        weeklyHours: country.legalWeeklyHours,
        realAnnualHours: null,
        monthlySavings: null,
        age: null,
        retirementAge: country.retirementAge,
      });
      const hours = r.hours;
      const workdays8h = r.workdays8h;
      let text: string;
      let unit: string;
      if (hours < 1) {
        text = formatMinutes(hours * 60);
        unit = text === "1" ? "minuto" : "minutos";
      } else if (workdays8h < 1) {
        text = formatHours(hours);
        unit = text === "1" ? "hora" : "horas";
      } else {
        text = formatWorkdays(workdays8h);
        unit = "jornadas";
      }
      return {
        product,
        local,
        price: price.value,
        workdays: text,
        unit,
        years: r.yearsFullPay,
      };
    } catch {
      return { product, local, price: price?.value ?? null, workdays: null, unit: null, years: null };
    }
  });

const categoryOrder: Product['category'][] = ['transporte', 'tecnologia', 'vivienda', 'vida', 'dia-a-dia'];
const catalog = categoryOrder
  .map((category) => ({
    category,
    products: products.filter((p) => p.visible && p.category === category),
  }))
  .filter((group) => group.products.length > 0);

/** Filas serializables para la isla CountryBoard (mismas cards que la portada). */
const boardGroups = catalog.map((group) => ({
  category: group.category,
  rows: quoteRows(group).map((row) => ({
    id: row.product.id,
    name: row.product.name,
    price: row.price,
    local: row.local,
    years: row.years,
    rateText: row.workdays,
    rateUnit: row.unit,
  })),
}));
---

<BaseLayout
  title={hasSalary ? og.country.title(country.name, countryWageText!) : `${country.name} · ${brand.name}`}
  description={og.country.description(country.name)}
  ogImage={`/og/${country.slug}.png`}
>
  <div class="max-w-5xl mx-auto px-4 pt-8 pb-20">
    <!-- ---- Placa de identidad ---- -->
    <div class="board-plate p-5">
      <p class="font-board-mono text-xs uppercase tracking-[0.14em] opacity-70">
        {board.operatingLabel}
      </p>
      <h1 class="font-signage uppercase text-4xl md:text-6xl leading-none mt-1">
        {country.name}
      </h1>
      {
        hasSalary && (
          <p class="mt-3 font-board-mono text-xs opacity-75 flex flex-wrap items-center gap-x-3 gap-y-1">
            <span>{countryPage.dataFrom(country.salariesUpdatedAt)}</span>
            <span aria-hidden="true" class="text-secondary">·</span>
            <span>{countryPage.sourceLabel}: {country.salariesSource}</span>
            <StaleDataBadge date={country.salariesUpdatedAt} />
          </p>
        )
      }
    </div>

    {
      !hasSalary && (
        <div role="alert" class="board-plate p-5 mt-4">
          <h2 class="font-signage uppercase text-2xl">{noSalary.title}</h2>
          <p class="text-sm opacity-80 mt-1">{noSalary.body}</p>
        </div>
      )
    }

    {
      hasSalary && (
        <section class="mt-8" aria-label={`${countryPage.hourlyWageLabel}: ${countryWageText}`}>
          <div class="flex items-end gap-4 md:gap-6 flex-wrap">
            <Odometer
              value={wageDigits}
              label={`${countryPage.hourlyWageLabel} ${countryWageText}`}
              class="text-[clamp(3.5rem,12vw,8rem)] leading-none"
            />
            <span class="font-signage uppercase text-primary text-[clamp(1.25rem,3vw,2.25rem)] leading-none pb-1 md:pb-2">
              {board.rateUnit(country.currencySymbol)}
            </span>
          </div>
          <p class="mt-2 font-board-mono text-xs opacity-75">{countryPage.dataDisclaimer}</p>

          <!-- ---- Retícula del país ---- -->
          <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-1.5">
            <div class="board-cell board-cell--fill">
              <span class="font-board-mono text-[0.625rem] uppercase tracking-[0.14em] opacity-80 block">{countryPage.weeklyHoursLabel}</span>
              <span class="font-board-mono text-2xl md:text-3xl tabular-nums leading-tight block mt-1">{country.legalWeeklyHours} h</span>
            </div>
            <div class="board-cell">
              <span class="font-board-mono text-[0.625rem] uppercase tracking-[0.14em] opacity-80 block">{countryPage.dailyHoursLabel}</span>
              <span class="font-board-mono text-2xl md:text-3xl tabular-nums leading-tight block mt-1">{country.legalDailyHours} h</span>
            </div>
            {country.realAnnualHours != null && (
              <div class="board-cell">
                <span class="font-board-mono text-[0.625rem] uppercase tracking-[0.14em] opacity-80 block">{countryPage.realAnnualHoursLabel}</span>
                <span class="font-board-mono text-2xl md:text-3xl tabular-nums leading-tight block mt-1">{formatIntegerThousands(country.realAnnualHours)}</span>
              </div>
            )}
          </div>

          <!-- Pulido Task 8: excepciones de jornada (FR 35 h, CO 42 h, CL 44 h)
               visibles; la referencia de 40 h no las tapa. -->
          {
            country.legalWeeklyHours !== 40 && (
              <p class="mt-2 font-board-mono text-xs opacity-75">
                {countryPage.weeklyHoursNote(country.legalWeeklyHours)}
              </p>
            )
          }
        </section>
      )
    }

    <!-- ---- Placas gemelas: tu tipo de cambio + precio libre ---- -->
    <div class="mt-10 grid gap-4 lg:grid-cols-2">
      <section class="board-plate p-5" aria-label={countryPage.toggleTitle}>
        <div class="flex flex-wrap items-start gap-3">
          <span class="board-cat-icon" style="background: #ffb020; color: #14191d">
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width={2}
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 17l6-6-6-6" />
              <path d="M12 19h8" />
            </svg>
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-signage uppercase text-2xl">{board.exchangeTitle}</h2>
              <span class="board-stamp text-primary">
                {userForm.currencyStamp(country.currencySymbol)}
              </span>
            </div>
            <p class="mt-1 text-sm opacity-80 max-w-2xl">{board.exchangeSubtitle(country.name)}</p>
          </div>
        </div>
        <div class="mt-4">
          <UserForm
            client:load
            countryCode={country.code}
            countryNetMonthly={country.medianNetMonthly}
            countryWeeklyHours={country.legalWeeklyHours}
            currencySymbol={country.currencySymbol}
          />
        </div>
      </section>

      <section class="board-plate p-5" aria-label={priceForm.priceLabel}>
        <div class="flex flex-wrap items-start gap-3">
          <span class="board-cat-icon" style="background: #3ec97e; color: #14191d">
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width={2}
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <path d="M21 21l-4.35-4.35" />
            </svg>
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-signage uppercase text-2xl">{priceForm.priceTitle}</h2>
              <span class="board-stamp text-primary">{priceForm.priceStamp}</span>
            </div>
            <p class="mt-1 text-sm opacity-80 max-w-2xl">{priceForm.priceNote}</p>
          </div>
        </div>
        <div class="mt-4">
          <PriceInput client:load slug={country.slug} currencySymbol={country.currencySymbol} />
        </div>
      </section>
    </div>

    <!-- ---- La pizarra del país (mismas cards que la portada) ---- -->
    <section class="mt-14" aria-label={board.countryBoard(country.name)}>
      <h2 class="font-signage uppercase text-4xl md:text-5xl">{board.countryBoard(country.name)}</h2>
      <p class="mt-1 mb-6 text-base opacity-80">{board.countryBoardSubtitle}</p>
      <CountryBoard
        client:visible
        slug={country.slug}
        currencySymbol={country.currencySymbol}
        groups={boardGroups}
      />
    </section>

  </div>
</BaseLayout>
