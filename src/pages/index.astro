---
import BaseLayout from '../layouts/BaseLayout.astro';
import RateBoard from '../components/preact/RateBoard.tsx';
import { og } from '../i18n/es.ts';
import type { Country, Product } from '../lib/types.ts';
import countriesData from '../data/countries.json';
import productsData from '../data/products.json';
import { generateHomeHreflangs, generateWebSiteSchema, generateWebApplicationSchema } from '../lib/seo.ts';

/**
 * Portada = tablero de cotizaciones. Todo el catálogo visible viaja a la isla
 * (países × precios) para que el cambio de país o de nómina recalcule en
 * vivo, en el dispositivo, sin pedir nada al servidor. */
const countries = countriesData as Country[];
const products = (productsData as Product[]).filter((product) => product.visible);

const siteUrl = Astro.site?.href ?? "https://precioentiempo.com";
const hreflangs = generateHomeHreflangs(countries, siteUrl);
const webSiteSchemas = generateWebSiteSchema(siteUrl);
const webAppSchema = generateWebApplicationSchema({
  name: "Calculadora de Precios en Tiempo de Trabajo",
  description: "Convierte precios de productos y gastos en horas, jornadas y años de trabajo real.",
  url: `${siteUrl.replace(/\/$/, "")}/`,
  applicationCategory: "FinanceApplication",
});
const jsonLd = [...webSiteSchemas, webAppSchema];
---

<BaseLayout
  title={og.home.title}
  description={og.home.description}
  ogImage="/og/index.png"
  hreflangs={hreflangs}
  jsonLd={jsonLd}
>
  <RateBoard client:load countries={countries} products={products} heroProductId="tesla-model-3" />
</BaseLayout>
