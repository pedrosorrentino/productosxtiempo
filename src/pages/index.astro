---
import BaseLayout from '../layouts/BaseLayout.astro';
import RateBoard from '../components/preact/RateBoard.tsx';
import { og } from '../i18n/es.ts';
import type { Country, Product } from '../lib/types.ts';
import countriesData from '../data/countries.json';
import productsData from '../data/products.json';
import { generateHomeHreflangs, generateWebSiteSchema, generateWebApplicationSchema } from '../lib/seo.ts';

/**
 * Portada = tablero de cotizaciones. Todo el catálogo visible viaja a la isla
 * (países × precios) para que el cambio de país o de nómina recalcule en
 * vivo, en el dispositivo, sin pedir nada al servidor. */
const countries = countriesData as Country[];
const products = (productsData as Product[]).filter((product) => product.visible);

const siteUrl = Astro.site?.href ?? "https://precioentiempo.com";
const hreflangs = generateHomeHreflangs(countries, siteUrl);
const webSiteSchemas = generateWebSiteSchema(siteUrl);
const webAppSchema = generateWebApplicationSchema({
  name: "Calculadora de Precios en Tiempo de Trabajo",
  description: "Convierte precios de productos y gastos en horas, jornadas y años de trabajo real.",
  url: `${siteUrl.replace(/\/$/, "")}/`,
  applicationCategory: "FinanceApplication",
});
const jsonLd = [...webSiteSchemas, webAppSchema];
---

<BaseLayout
  title={og.home.title}
  description={og.home.description}
  ogImage="/og/index.png"
  hreflangs={hreflangs}
  jsonLd={jsonLd}
>
  <RateBoard client:load countries={countries} products={products} heroProductId="tesla-model-3" />

  {/* Bloque de navegación en HTML servido (fuera del componente interactivo).
      Existe por dos razones: le sirve a quien llega buscando «cuánto vale un
      día/hora de trabajo en tal país» y es la única forma de que Googlebot
      llegue a esas 24 páginas desde la portada, que es una de las pocas que
      rastrea. Antes solo se enlazaban desde cada hub de país y desde las
      fichas, y ninguna de esas páginas las veía Google. */}
  <section class="max-w-5xl mx-auto px-4 pb-10 space-y-4">
    <h2 class="font-signage uppercase text-xl sm:text-2xl">Cuánto vale tu tiempo en cada país</h2>
    <p class="font-sans text-sm opacity-85 leading-relaxed">
      El sueldo de referencia de cada país, medido en lo que de verdad importa: cuánto vale una hora
      de trabajo, cuánto vale una jornada completa y qué se compra con ellas. Cada cifra, con su
      fuente y su año, y el cálculo a la vista.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
      {countries.map((c) => (
        <div class="board-cell p-3">
          <span class="block font-bold text-sm text-base-content">{c.name}</span>
          <span class="block font-board-mono text-xs mt-1">
            <a class="text-primary hover:underline" href={`/${c.slug}/sueldo-por-hora/`}>Sueldo por hora</a>
            {" · "}
            <a class="text-primary hover:underline" href={`/${c.slug}/dia-de-trabajo/`}>Día de trabajo</a>
          </span>
        </div>
      ))}
    </div>
    <p class="font-sans text-sm opacity-85">
      <a class="text-primary hover:underline font-semibold" href="/metodo/">Cómo se calcula y de dónde sale
      cada sueldo →</a>
    </p>
  </section>
</BaseLayout>
